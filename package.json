{
  "name": "update-files-action",
  "version": "0.1.0",
  "description": "A GitHub action for updating files.",
  "author": "Branislav Holý <brano@holy.am>",
  "repository": "github:branoholy/update-files-action",
  "bugs": {
    "url": "https://github.com/branoholy/update-files-action/issues"
  },
  "homepage": "https://github.com/branoholy/update-files-action#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.12.0",
    "pnpm": "12.11.2"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "pnpm:devPreinstall": "npx only-allow pnpm",
    "ri": "pnpm run clean-dependencies && pnpm i",
    "postinstall": "pnpm --silent run __git-hooks:setup",
    "build": "vite build",
    "build:production": "pnpm run build && rm -rf dist/ && cp -r build/ dist/",
    "clean-build": "./scripts/clean-build.sh",
    "clean-dependencies": "./scripts/clean-dependencies.sh",
    "release": "cluerise-tools release",
    "test": "CI=true pnpm --stream run '/^test:.*/'",
    "test:unit": "NODE_ENV=production vitest --configLoader runner --config ./vitest-unit.config.ts",
    "test:e2e": "NODE_ENV=production vitest --configLoader runner --config ./vitest-e2e.config.ts",
    "lint": "cluerise-tools lint",
    "type-check": "tsc --noEmit",
    "tc": "pnpm run type-check",
    "node-versions-update": "cluerise-tools update-node-versions",
    "setup-repository": "./scripts/setup-repository.sh",
    "__git-hook:commit-msg": "cluerise-tools format-commit-message",
    "__git-hook:post-commit": "find . -not -path './node_modules/*' -name .lint-staged-temp-tsconfig.json -type f -delete",
    "__git-hook:pre-commit": "pnpm run lint staged",
    "__git-hook:prepare-commit-msg": "cluerise-tools create-commit-message",
    "__git-hooks:setup": "[ -d .git ] && git config --local core.hooksPath ./hooks || echo 'Info: Git hooks not set outside a git repository.'"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@octokit/rest": "22.0.1",
    "btoa": "1.2.1",
    "envalid": "8.2.0",
    "glob": "13.0.6"
  },
  "devDependencies": {
    "@cluerise/tools": "5.5.9",
    "@types/btoa": "1.2.5",
    "@types/node": "26.6.5",
    "nock": "15.0.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
